{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paperless Scanner",
  "version": "0.1.0",
  "identifier": "com.paperlessscanner.app",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Paperless Scanner",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset:; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
