{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paperless Scanner",
  "version": "0.1.0",
  "identifier": "com.erikgoldenstein.paperlessscanner",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Paperless Scanner",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset:; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "copyright": "Copyright © 2026 Erik Goldenstein",
    "license": "GPL-3.0-or-later",
    "licenseFile": "LICENSE",
    "category": "Utility",
    "shortDescription": "Alpha touch-friendly scanner client for Paperless-ngx",
    "longDescription": "Alpha Linux scanner client: scan, review, create PDFs, and upload documents directly to Paperless-ngx.",
    "homepage": "https://github.com/erikgoldenstein/simple-scan-paperless",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2",
          "libsane1",
          "libssl3"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3",
          "librsvg2",
          "sane-backends",
          "openssl-libs"
        ]
      }
    }
  }
}
